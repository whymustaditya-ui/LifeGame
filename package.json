    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.12.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.9",
    "jsdom": "~29.1.1",
    "tsx": "^4.19.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  }
